# Copia este archivo a .env y rellena los valores. .env NUNCA se sube a git.
# Correo del orientador: único destinatario permitido para los borradores y envíos.
ORIENTADOR_EMAIL=orientador@ejemplo.com
# Nombres para el saludo y la firma del correo al orientador (así el borrador no lleva huecos por rellenar).
NOMBRE_ESTUDIANTE=Nombre Apellido
NOMBRE_ORIENTADOR=Nombre Apellido
# Zona horaria de los eventos de estudio.
ZONA_HORARIA=Europe/Madrid
