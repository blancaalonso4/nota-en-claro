# Copia este archivo a .env. .env NUNCA se sube a git.
# Los datos del orientador son de cada estudiante: se escriben en la pestaña «Datos» de la hoja «Mis notas» o en los campos
# «Tus datos de contacto» de la app, y esos valores mandan. Las tres líneas siguientes son SOLO el valor por defecto de la demo
# (se usan para lo que el estudiante no haya rellenado). Déjalas vacías si no quieres ningún valor por defecto.
ORIENTADOR_EMAIL=orientador@ejemplo.com
NOMBRE_ESTUDIANTE=Nombre Apellido
NOMBRE_ORIENTADOR=Nombre Apellido
# Zona horaria de los eventos de estudio.
ZONA_HORARIA=Europe/Madrid
